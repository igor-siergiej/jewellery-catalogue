{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "strict": false,
    "noImplicitAny": true,
    "preserveConstEnums": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "types": ["bun"]
  },
  "files": [],
  "references": [
    {
      "path": "packages/types"
    },
    {
      "path": "packages/api"
    },
    {
      "path": "packages/web"
    }
  ]
}
