{
  "name": "jewellery-catalogue",
  "private": true,
  "repository": "https://github.com/igor-siergiej/jewellery-catalogue",
  "author": "Igor Siergiej <igorsiergiej@gmail.com>",
  "scripts": {
    "start:web": "dotenv -e .env -- bun run --filter @jewellery-catalogue/web start",
    "start:web:with-mock": "dotenv -e .env -- bun run --filter @jewellery-catalogue/web start:with-mock",
    "start:api": "dotenv -e .env -- bun run --filter @jewellery-catalogue/api start",
    "start:etsy-mock": "bun run --filter @jewellery-catalogue/etsy-mock start",
    "start": "concurrently \"bun run start:web\" \"bun run start:api\"",
    "start:with-etsy-mock": "concurrently \"bun run start:web\" \"bun run start:api\" \"bun run start:etsy-mock\"",
    "start:with-mock": "concurrently \"bun run start:web:with-mock\" \"bun run start:api\"",
    "link-etsy-listings": "dotenv -e .env -- bun scripts/link-etsy-listings/index.ts",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "format": "vp fmt",
    "audit": "fallow-audit",
    "prepare": "vp config --no-agent",
    "release": "semantic-release",
    "check": "vp check"
  },
  "dependencies": {
    "fuse.js": "^7.5.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@imapps/dev-scripts": "0.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "concurrently": "^9.2.5",
    "dotenv-cli": "^8.0.0",
    "semantic-release": "^24.2.9",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "@imapps/oxc-config": "7.0.0",
    "@types/bun": "^1.4.4",
    "vite-plus": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "version": "1.81.1",
  "overrides": {
    "vite": "catalog:"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  }
}
