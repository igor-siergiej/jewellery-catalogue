FROM oven/bun:1.4.4-alpine AS builder

ARG APP_VERSION
ENV APP_VERSION=$APP_VERSION

WORKDIR /app

COPY package.json bun.lock ./
COPY packages packages/

RUN bun install --frozen-lockfile

COPY . .

RUN APP_VERSION="$APP_VERSION" bun run --filter @jewellery-catalogue/web build

FROM nginx:alpine

# Single source of truth for the web's nginx config — kept in
# packages/web/nginx.conf so the same rules ship to the e2e harness,
# the dev mirror, and prod. Avoids the heredoc drift we used to have.
RUN rm /etc/nginx/conf.d/default.conf
COPY packages/web/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/packages/web/build /usr/share/nginx/html

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
